<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <rect width="512" height="512" fill="#060c18" rx="80"/>
  <rect x="20" y="20" width="472" height="472" fill="none" stroke="#1a2d50" stroke-width="2" rx="70"/>

  <!-- Grade decorativa -->
  <g stroke="#0e1830" stroke-width="1" opacity="0.6">
    <line x1="0" y1="128" x2="512" y2="128"/>
    <line x1="0" y1="256" x2="512" y2="256"/>
    <line x1="0" y1="384" x2="512" y2="384"/>
    <line x1="128" y1="0" x2="128" y2="512"/>
    <line x1="256" y1="0" x2="256" y2="512"/>
    <line x1="384" y1="0" x2="384" y2="512"/>
  </g>

  <!-- Hexágono central -->
  <polygon points="256,80 346,131 346,233 256,284 166,233 166,131"
    fill="none" stroke="#22d3ee" stroke-width="3" opacity="0.5"/>
  <polygon points="256,100 330,145 330,235 256,280 182,235 182,145"
    fill="none" stroke="#4a9eff" stroke-width="1.5" opacity="0.3"/>

  <!-- Símbolo ₿ -->
  <text x="256" y="220" text-anchor="middle"
    font-family="'Courier New', monospace" font-size="120"
    font-weight="bold" fill="#22d3ee" opacity="0.9">₿</text>

  <!-- Texto PUZZLE #71 -->
  <text x="256" y="330" text-anchor="middle"
    font-family="'Courier New', monospace" font-size="28"
    font-weight="bold" fill="#4a9eff" letter-spacing="4">PUZZLE #71</text>

  <!-- Texto SCANNER -->
  <text x="256" y="365" text-anchor="middle"
    font-family="'Courier New', monospace" font-size="18"
    fill="#2a6090" letter-spacing="8">SCANNER</text>

  <!-- Versão -->
  <text x="256" y="410" text-anchor="middle"
    font-family="'Courier New', monospace" font-size="14"
    fill="#1a3050" letter-spacing="3">v4.0</text>

  <!-- Borda glow -->
  <rect x="20" y="20" width="472" height="472" fill="none"
    stroke="#22d3ee" stroke-width="1" rx="70" opacity="0.15"/>
</svg>
